{
  "name": "claims-platform-test-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Test automation for ClaimPay, a small healthcare claims and payments demo app",
  "license": "MIT",
  "author": "Rafiq Noori",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch app/src/main.ts",
    "start": "node dist/app/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx app/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx app/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:api && npm run test:contract && npm run test:e2e",
    "test:contract:consumer": "node --import tsx --test tests/contract/consumer.test.ts",
    "test:contract:provider": "node --env-file-if-exists=.env --import tsx --test tests/contract/provider.test.ts",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:quarantine": "playwright test --config playwright.quarantine.config.ts --project=chromium --pass-with-no-tests",
    "test:api": "node --env-file-if-exists=.env --import tsx --test \"tests/api/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
